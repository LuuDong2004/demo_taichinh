# Sao chép thành .env.local để chạy trên máy; trên Vercel khai báo ở Settings → Environment Variables.
# KHÔNG commit file .env.local (đã có trong .gitignore).

# Neon Postgres (Vercel → Storage → Neon). Bỏ trống khi chạy trên máy sẽ dùng PGlite lưu ở .data/pglite
DATABASE_URL=

# Tài khoản nhận tiền đã liên kết SePay
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# API Key đặt khi tạo webhook trên my.sepay.vn (kiểu xác thực "API Key")
SEPAY_API_KEY=

# Mật khẩu đăng nhập trang /admin (đặt dài, khó đoán)
ADMIN_PASSWORD=

# Trợ lý AI (Claude). Bỏ trống thì trợ lý dùng câu trả lời có sẵn
ANTHROPIC_API_KEY=
